rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SHOP SPHERE: ELITE MONTHLY GIFT CARD SYSTEM - SECURITY ARCHITECTURE
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /**
     * User profile data at sub-path aligned with backend.json
     */
    match /users/{userId}/profile/data {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    match /users/{userId}/rewardRedemptions/{redemptionId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    match /giftCardCodes/{giftCardCodeId} {
      allow read, write: if false; 
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && request.query.limit <= 100; // Simplified for MVP
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && request.query.limit <= 100;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Role check for admin status
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
